{
  "compilerOptions": {
    "lib": ["ESNext"],
    "rootDir": ".",
    "outDir": "./src",
    "module": "NodeNext",
    "target": "ES6",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "alwaysStrict": true,
    "allowUnreachableCode": false,
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": ["./src/**/*.ts"],
  "exclude": ["node_modules"]
}
